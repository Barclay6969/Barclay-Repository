+
+            worker = threading.Thread(name=thread_name, target=_thread._worker, args=worker_args)
+            worker.daemon = True
+            worker.start()
+            self._threads.add(worker)
+        except Exception as exc:
+            log_utils.log('xShip daemon executor fallback: %s' % str(exc), log_utils.LOGWARNING)
+            return super(_XshipThreadPoolExecutor, self)._adjust_thread_count()
