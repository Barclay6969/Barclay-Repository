+class _XshipThreadPoolExecutor(ThreadPoolExecutor):
+    """ThreadPool whose workers cannot hold Kodi's Python invoker open on exit.
+
+    Based on the xVault approach: workers are daemon threads and deliberately
+    are not registered in concurrent.futures.thread._threads_queues. Python's
+    global ThreadPoolExecutor exit hook therefore cannot join a resolver that
+    is stuck in network I/O after the xShip invocation is already finished.
+    """
+    def _adjust_thread_count(self):
+        try:
+            if self._idle_semaphore.acquire(timeout=0):
+                return
+
+            from concurrent.futures import thread as _thread
+
+            def weakref_cb(_, q=self._work_queue):
+                q.put(None)
+
+            num_threads = len(self._threads)
+            if num_threads >= self._max_workers:
+                return
+
+            thread_name = '%s_%d' % (self._thread_name_prefix or 'xship-worker', num_threads)
+            worker_params = len(inspect.signature(_thread._worker).parameters)
+            if worker_params == 3 and hasattr(self, '_create_worker_context'):
+                worker_args = (weakref.ref(self, weakref_cb), self._create_worker_context(), self._work_queue)
